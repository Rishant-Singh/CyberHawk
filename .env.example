# ─────────────────────────────────────────────────────────────
# CYBER THREAT INTELLIGENCE PLATFORM — Environment Variables
# Copy this file to .env and fill in production values
# ─────────────────────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=cti_user
POSTGRES_PASSWORD=cti_secure_pass_change_me
POSTGRES_DB=cti_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
ES_INDEX_LOGS=cti_logs
ES_INDEX_THREATS=cti_threats

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_RAW_TOPIC=raw-logs
KAFKA_SCORED_TOPIC=scored-threats
KAFKA_GROUP_ID=cti-ml-group

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-secure-random-256-bit-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Backend API
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Log Ingestion
LOG_RATE_PER_SECOND=5
MALICIOUS_RATIO=0.15

# ML Engine
MODELS_DIR=/app/models/saved
ANOMALY_THRESHOLD=0.65
THREAT_SCORE_HIGH=75
THREAT_SCORE_CRITICAL=90

# Initial Admin User
ADMIN_EMAIL=admin@cti.local
ADMIN_PASSWORD=Admin@CTI2024!
ADMIN_USERNAME=admin
